# Application Configuration
APP_NAME=Axiar API
VERSION=1.0.0
DEBUG=false
SECRET_KEY=test-secret-key-for-local-tests-only
ALLOWED_HOSTS=*

# Database Configuration
DATABASE_URL=postgresql+asyncpg://axiar:password@localhost:5432/axiar_test
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_NODES=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# AI Services
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_PERSIST_DIRECTORY=./chroma_db

# External APIs (REQUIRED: Replace with real values)
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
SENDGRID_API_KEY=SG.dummy
TWILIO_ACCOUNT_SID=dummy
TWILIO_AUTH_TOKEN=dummy
TWILIO_PHONE_NUMBER=+1234567890
GOOGLE_MAPS_API_KEY=dummy

# OAuth Configuration (REQUIRED: Replace with real values)
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
MICROSOFT_CLIENT_ID=dummy
MICROSOFT_CLIENT_SECRET=dummy

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Multi-tenancy
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_LEVEL=row_level

# Environment (development|staging|production) — tags Sentry events
ENVIRONMENT=development

# Monitoring (optional — Sentry init is skipped when SENTRY_DSN is unset)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Push Notifications (REQUIRED: Generate with web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@example.com
