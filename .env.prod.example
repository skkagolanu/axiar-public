# cp .env.prod.example .env.prod, fill in real values, never commit the copy.
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Postgres
POSTGRES_PASSWORD=

SECRET_KEY=
SESSION_SECRET_KEY=

# Host/CORS allow-lists -- comma-separated real values, NEVER "*"
# (Settings.production_guard fails startup on a wildcard when ENVIRONMENT=production)
ALLOWED_HOSTS=
CORS_ORIGINS=
FRONTEND_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid / Twilio
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps / OAuth
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional (blank is fine -- push notifications / error tracking degrade to
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=

# Frontend build-time API origin (Vite bakes this in at image build, not runtime
# -- rebuild the frontend image if this changes)
VITE_API_URL=

# Host port the frontend nginx is published on (container always listens on 80)
FRONTEND_PORT=8080
